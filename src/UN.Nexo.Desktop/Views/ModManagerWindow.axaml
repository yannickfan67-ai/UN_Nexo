<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UN.Nexo.Desktop.Views.ModManagerWindow"
        Title="Nexo Mods"
        Width="880" Height="650"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F14">
  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#121923" />
      <Setter Property="BorderBrush" Value="#202B38" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8E9AAA" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6D5DFB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid Margin="24" RowDefinitions="Auto,16,Auto,16,*,16,Auto">
    <StackPanel>
      <TextBlock Text="Instance mods" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Text="Install local Fabric mod JARs into the selected Nexo instance. Each instance keeps its own isolated game/mods directory." Classes="muted" Margin="0,5,0,0" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2" Classes="card">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel>
          <TextBlock Text="Instance" Classes="muted" FontSize="11" />
          <ComboBox x:Name="InstanceBox" SelectionChanged="OnInstanceSelectionChanged" MaxDropDownHeight="300">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Loader}" Classes="muted" FontSize="11" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock x:Name="InstanceDetail" Text="Choose a Fabric instance." Classes="muted" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh" Click="OnRefreshClicked" Padding="14,9" VerticalAlignment="Bottom" />
      </Grid>
    </Border>

    <Border Grid.Row="4" Classes="card">
      <Grid RowDefinitions="Auto,12,*,12,Auto">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel>
            <TextBlock Text="Installed mods" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="ModsDirectoryLabel" Text="No instance selected." Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" x:Name="InstallButton" Classes="primary" Content="Install JAR…" Click="OnInstallClicked" IsEnabled="False" />
        </Grid>

        <ListBox Grid.Row="2" x:Name="ModsList" SelectionChanged="OnModSelectionChanged" Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="7,7" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding FileName}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding SizeLabel}" Classes="muted" FontSize="11" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="9">
          <Button x:Name="ToggleButton" Content="Disable selected" Click="OnToggleClicked" IsEnabled="False" Padding="14,9" />
          <Button Grid.Column="1" x:Name="RemoveButton" Content="Remove selected" Click="OnRemoveClicked" IsEnabled="False" Padding="14,9" />
          <TextBlock Grid.Column="2" x:Name="CountLabel" Text="0 mods" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="6" Background="#101720" CornerRadius="10" Padding="12">
      <TextBlock x:Name="OperationStatus" Text="Ready." Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
