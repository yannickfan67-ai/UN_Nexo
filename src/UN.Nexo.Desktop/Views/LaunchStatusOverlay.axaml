<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UN.Nexo.Desktop.Views.LaunchStatusOverlay"
             IsVisible="{Binding IsGameRunning}"
             IsHitTestVisible="False">
  <Grid>
    <Border HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,18,18,0"
            Width="370"
            Background="#F0121923"
            BorderBrush="#344357"
            BorderThickness="1"
            CornerRadius="13"
            Padding="15,12">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Border Width="8" Height="8" CornerRadius="4" Background="#6D5DFB" VerticalAlignment="Center" />
          <TextBlock Text="GAME SESSION"
                     Foreground="#AAB5C4"
                     FontSize="10"
                     FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Grid.Row="1"
                   Text="{Binding GameStatus}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="2" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
