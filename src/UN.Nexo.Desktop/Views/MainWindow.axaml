<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UN.Nexo.Desktop.Views.MainWindow"
        Title="UN_Nexo"
        Width="1180" Height="720"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6D5DFB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#121923" />
      <Setter Property="BorderBrush" Value="#202B38" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8E9AAA" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="238,*">
    <Border Grid.Column="0" Background="#0E141C" BorderBrush="#1D2732" BorderThickness="0,0,1,0" Padding="18">
      <Grid RowDefinitions="Auto,28,*,Auto">
        <StackPanel>
          <TextBlock Text="UN_Nexo" FontSize="26" FontWeight="SemiBold" />
          <TextBlock Text="Minecraft Launcher" Classes="muted" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2">
          <Button Classes="nav" Content="Home" Command="{Binding ShowHomeCommand}" />
          <Button Classes="nav" Content="Instances" Command="{Binding ShowInstancesCommand}" />
          <Button Classes="nav" Content="Accounts" Command="{Binding ShowAccountsCommand}" />
          <Button Classes="nav" Content="Downloads" IsHitTestVisible="False" Opacity="0.35" />
          <Button Classes="nav" Content="Settings" Command="{Binding ShowSettingsCommand}" />
        </StackPanel>

        <Border Grid.Row="3" Background="#111923" CornerRadius="10" Padding="12">
          <StackPanel>
            <TextBlock Text="v0.3.1-dev" FontWeight="SemiBold" />
            <TextBlock Text="{Binding LauncherStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <ScrollViewer IsVisible="{Binding IsHomeVisible}">
        <StackPanel Margin="34" Spacing="18" MaxWidth="980" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Ready when you are." FontSize="32" FontWeight="SemiBold" />
              <TextBlock Text="Pick an instance and account, then let Nexo handle the environment." Classes="muted" Margin="0,6,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshEnvironmentCommand}" Padding="16,10" VerticalAlignment="Center" />
          </Grid>

          <Border Classes="card" Background="#151D2A">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
              <StackPanel Spacing="6">
                <TextBlock Text="CURRENT INSTANCE" Classes="muted" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedInstance.Name, FallbackValue=No instance selected}" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedInstance.VersionId, FallbackValue=Create an instance to get started}" Classes="muted" />
                <TextBlock Text="{Binding AccountSummary}" Classes="muted" Margin="0,4,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                <Button Classes="primary" Content="Play" IsEnabled="False" MinWidth="150" />
                <TextBlock Text="Launch pipeline in development" Classes="muted" FontSize="11" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="1.25*,*" ColumnSpacing="18">
            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Minecraft catalog" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Version metadata and downloads" Classes="muted" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding CatalogStatus}" Classes="muted" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="Latest release" Classes="muted" FontSize="11" />
                  <TextBlock Text="{Binding LatestRelease}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                  <TextBlock Text="Snapshot" Classes="muted" FontSize="11" HorizontalAlignment="Right" Margin="0,7,0,0" />
                  <TextBlock Text="{Binding LatestSnapshot}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card">
              <StackPanel>
                <TextBlock Text="Environment" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding JavaSummary}" Margin="0,9,0,0" />
                <TextBlock Text="{Binding JavaDetail}" Classes="muted" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
            <Border Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Accounts" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AccountSummary}" Margin="0,6,0,0" />
                  <TextBlock Text="Offline profiles are for local/offline-mode play." Classes="muted" FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Manage" Command="{Binding ShowAccountsCommand}" Padding="14,9" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Download source" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding SelectedDownloadSource}" Margin="0,6,0,0" />
                  <TextBlock Text="{Binding DownloadSourceStatus}" Classes="muted" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Settings" Command="{Binding ShowSettingsCommand}" Padding="14,9" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>

          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Instances" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="{Binding InstanceSummary}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding InstanceRoot}" Classes="muted" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,4,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Content="Manage instances" Command="{Binding ShowInstancesCommand}" Padding="15,9" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid IsVisible="{Binding IsInstancesVisible}" Margin="30" RowDefinitions="Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Instances" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Each instance keeps its own game files and version metadata." Classes="muted" Margin="0,5,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="Back to home" Command="{Binding ShowHomeCommand}" Padding="14,9" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="230,*" ColumnSpacing="18">
          <Border Classes="card" Padding="14">
            <Grid RowDefinitions="Auto,12,*,12,Auto">
              <TextBlock Text="Your instances" FontSize="17" FontWeight="SemiBold" />
              <ListBox Grid.Row="2" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="7,6">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding VersionId}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="4" Text="Select an instance to prepare or inspect it." Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="18">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <StackPanel>
                    <TextBlock Text="Create instance" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Start with Vanilla. Mod loaders will be added on top of the same instance model." Classes="muted" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10" ColumnSpacing="10">
                    <TextBox Grid.ColumnSpan="2" Watermark="Instance name" Text="{Binding NewInstanceName}" />
                    <ComboBox Grid.Row="1" ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedVersion}" MaxDropDownHeight="360" MinWidth="120">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Type}" Classes="muted" FontSize="11" Margin="10,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Row="1" Grid.Column="1" Classes="primary" Content="Create" Command="{Binding CreateInstanceCommand}" IsEnabled="{Binding HasSelectedVersion}" />
                  </Grid>
                  <TextBlock Text="{Binding CatalogStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="10">
                    <StackPanel>
                      <TextBlock Text="Selected instance" Classes="muted" FontSize="11" />
                      <TextBlock Text="{Binding SelectedInstance.Name, FallbackValue=Nothing selected}" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding SelectedInstance.VersionId, FallbackValue=Choose an instance on the left}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Content="Prepare Vanilla files" Command="{Binding PrepareSelectedInstanceCommand}" IsEnabled="{Binding HasSelectedInstance}" Padding="16,10" HorizontalAlignment="Left" />
                  </StackPanel>
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallProgressValue}" Height="7" />
                  <TextBlock Text="{Binding InstallProgressText}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <Border Background="#0E141C" CornerRadius="9" Padding="12">
                    <TextBlock Text="The selected download source is used first. BMCLAPI automatically falls back to official URLs if a mirrored file is missing or unavailable." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <Grid IsVisible="{Binding IsAccountsVisible}" Margin="30" RowDefinitions="Auto,*" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Accounts" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="Keep offline profiles separate from authenticated Microsoft accounts." Classes="muted" Margin="0,5,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="Back to home" Command="{Binding ShowHomeCommand}" Padding="14,9" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="230,*" ColumnSpacing="18">
          <Border Classes="card" Padding="14">
            <Grid RowDefinitions="Auto,12,*,12,Auto">
              <TextBlock Text="Profiles" FontSize="17" FontWeight="SemiBold" />
              <ListBox Grid.Row="2" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="7,6">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding TypeLabel}" Classes="muted" FontSize="11" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="4" Text="Offline profiles cannot authenticate to online-mode servers." Classes="muted" FontSize="11" TextWrapping="Wrap" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="18">
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="Offline profile" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="Useful for local worlds, development and offline-mode test servers. It does not replace Minecraft ownership or Microsoft authentication." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <StackPanel Spacing="10">
                    <TextBox Watermark="Minecraft name (3-16 characters)" Text="{Binding OfflineUserName}" />
                    <Button Classes="primary" Content="Add offline profile" Command="{Binding CreateOfflineAccountCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel Spacing="12">
                  <TextBlock Text="Microsoft account" FontSize="19" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding MicrosoftAuthStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  <Button Content="Microsoft sign-in status" Command="{Binding ExplainMicrosoftSignInCommand}" HorizontalAlignment="Left" Padding="15,9" />
                  <Border Background="#0E141C" CornerRadius="9" Padding="12">
                    <TextBlock Text="Nexo will use its own Microsoft application registration and the official Microsoft → Xbox Live → XSTS → Minecraft Services flow. Third-party launcher client IDs will not be copied or spoofed." Classes="muted" FontSize="12" TextWrapping="Wrap" />
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <ScrollViewer IsVisible="{Binding IsSettingsVisible}">
        <StackPanel Margin="34" Spacing="18" MaxWidth="900" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="Settings" FontSize="32" FontWeight="SemiBold" />
              <TextBlock Text="Prefer safe defaults; expose the knobs that actually matter." Classes="muted" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Back to home" Command="{Binding ShowHomeCommand}" Padding="14,9" VerticalAlignment="Center" />
          </Grid>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="Download source" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="Choose where Minecraft metadata, client files, libraries and assets are fetched first." Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="280,Auto" ColumnSpacing="10">
                <ComboBox ItemsSource="{Binding DownloadSources}" SelectedItem="{Binding SelectedDownloadSource}" />
                <Button Grid.Column="1" Classes="primary" Content="Save and refresh" Command="{Binding SaveDownloadSourceCommand}" />
              </Grid>
              <TextBlock Text="{Binding DownloadSourceStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              <Border Background="#0E141C" CornerRadius="9" Padding="12">
                <TextBlock Text="BMCLAPI mode uses the mirror for Mojang version metadata, client files, libraries and assets. Every rewritten request retains the official URL as fallback, and SHA-1 checks still apply." Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
