<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="UN.Nexo.Desktop.Views.MainWindow" Title="UN_Nexo Downloads" Width="1160" Height="760"
 MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#0B1018">
 <Window.Styles>
  <Style Selector="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="CornerRadius" Value="2"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#52D4E8"/><Setter Property="Foreground" Value="#08232B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="#141E2B"/><Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="3"/></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#9AAFC5"/></Style>
  <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Styles>
 <Grid RowDefinitions="Auto,*,Auto">
  <Border Padding="30,22" Background="#101A27">
   <Grid ColumnDefinitions="*,Auto">
    <StackPanel Spacing="3"><TextBlock Text="UN_Nexo" FontSize="28" FontWeight="Bold"/><TextBlock Text="下載限定版 · 你的遊戲檔案工作區" Classes="muted"/></StackPanel>
    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5"><TextBlock Text="{Binding VersionLabel}" HorizontalAlignment="Right"/><TextBlock Text="無登入 · 無遊戲啟動" Foreground="#52D4E8"/></StackPanel>
   </Grid>
  </Border>
  <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab}" Margin="24,16">
   <TabItem Header="探索版本">
    <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="0,16,0,0">
     <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
      <Border Classes="card" Background="#153D4B"><StackPanel Spacing="6"><TextBlock Text="最新正式版"/><TextBlock Text="{Binding LatestRelease}" Classes="title"/></StackPanel></Border>
      <Border Grid.Column="1" Classes="card" Background="#25314F"><StackPanel Spacing="6"><TextBlock Text="最新快照"/><TextBlock Text="{Binding LatestSnapshot}" Classes="title"/></StackPanel></Border>
     </Grid>
     <Grid Grid.Row="1" ColumnDefinitions="*,310" ColumnSpacing="18">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
       <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="10">
        <TextBox PlaceholderText="搜尋版本，例如 1.21.4、1.8.9" Text="{Binding Query}"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" HorizontalAlignment="Stretch"/>
        <Button Grid.Column="2" Content="更新" Command="{Binding RefreshCatalogCommand}"/>
       </Grid>
       <TextBlock Grid.Row="1" Text="{Binding CatalogStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
       <ListBox Grid.Row="2" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" Background="#101925">
        <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="8,7"><TextBlock Text="{Binding Id}" FontSize="16"/><TextBlock Grid.Column="1" Text="{Binding Type}" Classes="muted"/></Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
      <Border Grid.Column="1" Classes="card"><ScrollViewer><StackPanel Spacing="16">
       <TextBlock Text="開始下載" Classes="title"/>
       <TextBlock Text="{Binding SelectedVersion.Id, FallbackValue=請選擇版本}" FontSize="30" Foreground="#52D4E8"/>
       <TextBlock Text="下載客戶端、程式庫、原生檔案及資源，完成後校驗官方 SHA-1。" TextWrapping="Wrap" Classes="muted"/>
       <TextBox PlaceholderText="自訂名稱（選填）" Text="{Binding InstanceName}"/>
       <Button Classes="primary" Content="加入下載佇列" Command="{Binding QueueVersionCommand}" HorizontalAlignment="Stretch"/>
       <Separator/>
       <TextBlock Text="遊戲所有權" FontWeight="SemiBold"/>
       <TextBlock Text="下載不代表取得遊戲授權。遊玩仍需合法持有 Java Edition，請使用具備官方登入與所有權驗證的啟動器。" Classes="muted" TextWrapping="Wrap" FontSize="12"/>
      </StackPanel></ScrollViewer></Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="本機版本">
    <Grid ColumnDefinitions="*,330" ColumnSpacing="18" Margin="0,16,0,0">
     <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10" Spacing="4"><TextBlock Text="{Binding Name}" FontSize="19"/><TextBlock Text="{Binding VersionId}" Classes="muted"/><TextBlock Text="{Binding Loader}" Classes="muted" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Border Grid.Column="1" Classes="card"><StackPanel Spacing="16">
      <TextBlock Text="檔案管理" Classes="title"/><TextBlock Text="{Binding SelectedInstance.Name, FallbackValue=選擇本機版本}" TextWrapping="Wrap"/>
      <Button Classes="primary" Content="校驗並修復檔案" Command="{Binding RepairInstanceCommand}" HorizontalAlignment="Stretch"/>
      <Button Content="開啟遊戲檔案資料夾" Command="{Binding OpenInstanceFolderCommand}" HorizontalAlignment="Stretch"/>
      <TextBlock Text="校驗與修復會重新檢查官方檔案，只補下載缺失或損壞內容。存檔、模組和個人設定會保留。" TextWrapping="Wrap" Classes="muted" FontSize="12"/>
      <Separator/><TextBox PlaceholderText="重新命名" Text="{Binding RenameName}"/><Button Content="儲存名稱" Command="{Binding RenameInstanceCommand}"/>
     </StackPanel></Border>
    </Grid>
   </TabItem>
   <TabItem Header="下載佇列">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16" Margin="0,16,0,0">
     <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{Binding ActiveName}" FontSize="23"/><ProgressBar Value="{Binding Progress}" Maximum="100" Height="8" Foreground="#52D4E8"/><TextBlock Text="{Binding Transfer}" TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
     <WrapPanel Grid.Row="1" Orientation="Horizontal">
      <Button Content="暫停佇列" Command="{Binding PauseQueueCommand}" Margin="0,0,10,0"/>
      <Button Classes="primary" Content="繼續佇列" Command="{Binding ResumeQueueCommand}" Margin="0,0,10,0"/>
      <Button Content="重試選中任務" Command="{Binding RetryJobCommand}" Margin="0,0,10,0"/>
      <Button Content="匯出下載報告" Command="{Binding ExportReportCommand}"/>
     </WrapPanel>
     <ListBox Grid.Row="2" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,100" Margin="8"><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionId}" Classes="muted"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" FontSize="12"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding StateLabel}" Foreground="#52D4E8" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
   </TabItem>
   <TabItem Header="設定與關於">
    <ScrollViewer Margin="0,16,0,0"><StackPanel Spacing="18">
     <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="下載來源" Classes="title"/><ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" MinWidth="280"/><Button Content="儲存下載設定" Command="{Binding SaveSettingsCommand}"/><TextBlock Text="預設使用官方來源；BMCLAPI 模式保留官方備援和檔案雜湊驗證。" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="本機資料" Classes="title"/><TextBlock Text="{Binding DataRoot}" TextWrapping="Wrap" Classes="muted"/><Button Content="開啟資料資料夾" Command="{Binding OpenDataFolderCommand}"/><TextBlock Text="下載佇列及目錄會保存在本機。重新開啟後，未完成任務會暫停，等待你選擇繼續。PC 端保留已校驗的完整檔案；單一中斷檔案會重新下載。" TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
     <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="UN_Nexo · 獨立開源專案" Classes="title"/><TextBlock Text="維護者：Yannick Fan / yannickfan67-ai&#10;聯絡：GitHub Issues&#10;原始碼：github.com/yannickfan67-ai/UN_Nexo&#10;授權：MIT（僅限本專案程式碼）" TextWrapping="Wrap"/><TextBlock Text="NOT AN OFFICIAL MINECRAFT PRODUCT. NOT APPROVED BY OR ASSOCIATED WITH MOJANG OR MICROSOFT." TextWrapping="Wrap" FontSize="12" Classes="muted"/><TextBlock Text="此發行版只提供檔案下載管理。登入、帳號資料讀取、遊戲啟動及伺服器連線不包含於發行組件。未來遊玩功能需要經批准的應用程式登入與正版所有權驗證。" TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#101A27" Padding="28,13"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#BDD0E1" FontSize="12"/></Border>
 </Grid>
</Window>
